            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Width" Value="172" />
            <Setter Property="Height" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- Faint line-art above an empty page's message. -->
        <Style x:Key="EmptyIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="54" />
            <Setter Property="Foreground" Value="{StaticResource Placeholder}" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <!-- A strip of washi tape holding a card or note to the page. -->
        <Style x:Key="Tape" TargetType="Border">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="#A6E7B9A1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-12,0,0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- Two families only. Print is everything typed: headings, essays, tasks, Chinese passages, buttons.
             Hand is everything written by hand: the teacher's red pen, margin notes and big tallies. Segoe Print has
             no Chinese, so Chinese inside handwriting falls through to LXGW WenKai (see App.UsePerUserFonts). -->
        <FontFamily x:Key="Print">Noto Serif SC, STZhongsong, SimSun</FontFamily>
        <FontFamily x:Key="Hand">Segoe Print, LXGW WenKai, KaiTi, STKaiti</FontFamily>

        <!-- One ruled row is 40 px; the editor uses the same line height so text sits on the rules. -->
        <DrawingBrush x:Key="RuledPaper" TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FBF8F0">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,40,40" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#CFDCE6">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,39,40,1" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <BooleanToVisibilityConverter x:Key="Shown" />
        <local:HiddenWhenTrue x:Key="Hidden" />
        <local:EqualsConverter x:Key="Is" />

        <!-- Buttons -->
        <Style x:Key="Plain" TargetType="ButtonBase">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <!-- Centred by default; a button that lists text (a source sentence) asks for Left and must get it. -->
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource RedPen}" />
                                <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small glyph button on a contents row; it only shows on the row under the cursor or the selected row. -->
        <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource Plain}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource RedPen}" />
                    <Setter Property="Background" Value="#E6DAC0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Title bar: the window's name and caption buttons sitting straight on the desk. Everything dims when the window
             is not active, as the system bar does. Tag carries hover/press for the maximize button, whose mouse input
             arrives as non-client messages (see TitleBar) and never reaches WPF. -->
        <Style x:Key="CaptionTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Placeholder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Caption" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Placeholder}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F5A3E1A" />
                </Trigger>
                <Trigger Property="Tag" Value="hot">
                    <Setter Property="Background" Value="#1F5A3E1A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#335A3E1A" />
                </Trigger>
                <Trigger Property="Tag" Value="pressed">
                    <Setter Property="Background" Value="#335A3E1A" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptionMaximize" TargetType="Button" BasedOn="{StaticResource Caption}">
            <Setter Property="Content" Value="&#xE922;" />
            <Setter Property="ToolTip" Value="最大化" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;" />
                    <Setter Property="ToolTip" Value="还原" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RedPen}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A52A21" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InkButton" TargetType="Button" BasedOn="{StaticResource Plain}">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="Foreground" Value="#FBF8F0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style x:Key="LineButton" TargetType="Button" BasedOn="{StaticResource Plain}">
            <Setter Property="BorderBrush" Value="{StaticResource InkSoft}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style x:Key="DashedButton" TargetType="Button" BasedOn="{StaticResource Plain}">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Face" Background="Transparent" Height="40">
                            <Rectangle RadiusX="8" RadiusY="8" Stroke="#A8977A" StrokeThickness="2" StrokeDashArray="3 2" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#EDE4CF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Coloured divider tabs; the open one pokes further out in paper colour. -->
        <Style x:Key="DividerTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="26,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="10,0,0,10">
                            <Grid>
                                <!-- Card-stock sheen on the top half of the tab. -->
                                <Border CornerRadius="10,0,0,0" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#55FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                            <GradientStop Color="#00000000" Offset="0.8" />
                                            <GradientStop Color="#14000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="2" Direction="225" BlurRadius="0" Opacity="0.12" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource RedPen}" />
                                <Setter TargetName="Face" Property="BorderThickness" Value="2,2,0,2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Height" Value="64" />
                    <Setter Property="Margin" Value="18,0,0,10" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="15" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsDividerTab" TargetType="RadioButton" BasedOn="{StaticResource DividerTab}">
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Height" Value="58" />
                    <Setter Property="Margin" Value="18,0,0,10" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="15" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text boxes without chrome; Tag is the placeholder. -->
        <Style x:Key="Bare" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="#F2C4BB" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource Placeholder}"
                                           FontStyle="Italic" Margin="2,0,0,0" TextWrapping="Wrap" IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Writing" TargetType="TextBox" BasedOn="{StaticResource Bare}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="SpellCheck.IsEnabled" Value="False" />
        </Style>

        <!-- A choice written on a ruled line, like the other fields: no Windows box, a chevron on the right and a
             paper drop-down. Editable combos type into a bare text box; the chevron stays clickable beside it. -->
        <Style x:Key="ComboRow" TargetType="ComboBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="10,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource PaperLeft}" />
                                <Setter Property="Foreground" Value="{StaticResource RedPen}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#EFE6D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LineCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboRow}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Line" Background="Transparent" BorderBrush="{StaticResource InkSoft}" BorderThickness="0,0,0,1.5" />
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource RedPen}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Picked" IsHitTestVisible="False" Margin="2,7,30,7" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource Bare}" Margin="0,7,30,7" VerticalAlignment="Center"
                                     Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}" Tag="{TemplateBinding Tag}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="0,4,12,12" TextOptions.TextFormattingMode="Display"
                                        Background="{StaticResource Paper}" BorderBrush="{StaticResource PaperEdge}" BorderThickness="1"
                                        CornerRadius="6" Padding="4" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#3C280A" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Picked" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource RedPen}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One of several choices: an inked ring, filled with a red-pen dot when chosen. -->
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Fill="White" Stroke="{StaticResource InkSoft}" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource RedPen}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource RedPen}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource RedPen}" />
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Table of contents rows. -->
        <Style x:Key="TocRow" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"
                                CornerRadius="6" Padding="10,9" Margin="0,0,0,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#EFE6D2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Paper}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource InkSoft}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource RedPen}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin pencil-like scroll bars. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,6">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#C9BC9F" CornerRadius="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="PART_Track" Property="Margin" Value="6,3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10" />
                    <Setter Property="MinWidth" Value="10" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
