        <!-- Calligraphy lettered straight onto the desk, where the desk shows: Gabriola ships with Windows. -->
        <Style x:Key="DeskLettering" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Gabriola, Segoe Script" />
            <Setter Property="Foreground" Value="#4D5A3E1A" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>
        <!-- The program's mark: an ink bottle, half full of blue-black ink, drawn on a 48 x 48 grid.
             Used in the title bar, at the top of each book's left page, faintly on the settings page and for the .ico. -->
