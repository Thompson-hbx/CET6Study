# Read by ktlint and the IDE. Matches the project's written style: official Kotlin style, long lines,
# star imports, and Compose functions named like types.
root = true

[*]
charset = utf-8
insert_final_newline = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 160
ktlint_code_style = intellij_idea
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_filename = disabled
